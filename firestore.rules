rules_version = '2';

// シフトボードと、みんなの作品棚（sakuhin-dana）のデータを守るルール（同じ Firebase を使うので1つのファイルにまとめている）。
// shift-board/firestore.rules と sakuhin-dana/firestore.rules は同じ内容にしておく。
// Firebase コンソール → Firestore Database → ルール にこの内容を貼り付けて「公開」します。
// 管理者は、下のアドレスで Google ログインした人だけ（firebase-config.js の adminEmail と同じ）。
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == "google.com"
        && request.auth.token.email_verified == true
        && request.auth.token.email == "masaru20040201@gmail.com";
    }
    // 招待リンクで参加した端末（匿名ログイン）には sessions/<uid> がある
    function isMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/sessions/$(request.auth.uid));
    }
    function myStaffId() {
      return get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.staffId;
    }
    // 見るだけリンクで開いた端末: viewers/<uid> の合言葉が、今の見るだけリンク（viewTokens/main）と同じ
    function isViewer() {
      return request.auth != null
        && exists(/databases/$(database)/documents/viewers/$(request.auth.uid))
        && exists(/databases/$(database)/documents/viewTokens/main)
        && get(/databases/$(database)/documents/viewers/$(request.auth.uid)).data.token
           == get(/databases/$(database)/documents/viewTokens/main).data.token;
    }
    function canRead() {
      return isAdmin() || isMember() || isViewer();
    }

    // スタッフの名前と色、シフト、お店の設定と必要人数: 参加者が読み、店長だけが書く
    match /staff/{id}     { allow read: if canRead(); allow write: if isAdmin(); }
    match /shifts/{id}    { allow read: if canRead(); allow write: if isAdmin(); }
    match /settings/{id}  { allow read: if canRead(); allow write: if isAdmin(); }

    // 時給・メール、招待リンクの合言葉: 店長だけ
    match /private/{id}     { allow read, write: if isAdmin(); }
    match /staffTokens/{id} { allow read, write: if isAdmin(); }

    // 希望シフト（文書 ID は <スタッフID>_<YYYY-MM>）: 参加者が読み、スタッフは自分の分だけ書ける
    match /requests/{id} {
      allow read: if canRead();
      allow create, update: if isAdmin() || (
        isMember()
        && request.resource.data.staffId == myStaffId()
        && request.resource.data.month is string
        && id == request.resource.data.staffId + "_" + request.resource.data.month
      );
      allow delete: if isAdmin();
    }

    // 見るだけリンクの合言葉: 店長だけ。作り直すか消すと、前のリンクで開いた端末は読めなくなる
    match /viewTokens/{id} { allow read, write: if isAdmin(); }

    // 見るだけの記録: 見るだけリンクの合言葉が正しいときだけ、自分の分を作れる（書き込みの権限は増えない）
    match /viewers/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list, delete: if isAdmin();
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["token", "createdAt"])
        && request.resource.data.token is string
        && exists(/databases/$(database)/documents/viewTokens/main)
        && get(/databases/$(database)/documents/viewTokens/main).data.token == request.resource.data.token;
    }

    // ===== みんなの作品棚（ponntatta.github.io/sakuhin-dana）。コレクション名は hub_ で始まる =====
    // メンバー: hub_members/<uid> がある Google ログインの人（管理者は常にメンバー扱い）
    function hubMember() {
      return isAdmin() || (request.auth != null
        && request.auth.token.firebase.sign_in_provider == "google.com"
        && exists(/databases/$(database)/documents/hub_members/$(request.auth.uid)));
    }
    function hubItemOk(d) {
      return d.keys().hasOnly(["title", "url", "desc", "tags", "emoji", "color", "makers", "updatedAt", "updatedBy", "ownerUid", "createdAt", "likes"])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 60
        && d.url is string && d.url.size() <= 500 && (d.url == "" || d.url.matches("https?://[^ ]+"))
        && d.desc is string && d.desc.size() <= 600
        && d.tags is list && d.tags.size() <= 8
        && d.emoji is string && d.emoji.size() <= 8
        && d.color is int && d.color >= 0 && d.color <= 5
        && d.makers is list && d.makers.size() >= 1 && d.makers.size() <= 12
        && d.likes is list && d.likes.size() <= 200
        && d.ownerUid is string && d.updatedBy is string;
    }
    // 招待リンクの合言葉: 管理者だけ
    match /hub_meta/{id} { allow read, write: if isAdmin(); }
    // メンバー: メンバーどうしで見られる。参加は招待リンクの合言葉が正しいときだけ。名前と写真は本人が直せる
    match /hub_members/{uid} {
      allow read: if hubMember();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == "google.com"
        && request.resource.data.keys().hasOnly(["name", "photo", "joinedAt", "token", "admin"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.admin is bool && (request.resource.data.admin == false || isAdmin())
        && (isAdmin() || (exists(/databases/$(database)/documents/hub_meta/invite)
            && get(/databases/$(database)/documents/hub_meta/invite).data.token == request.resource.data.token));
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "photo"])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }
    // 作品: メンバーはだれでも見る・追加・編集できる。消せるのは追加した本人と管理者だけ
    match /hub_items/{id} {
      allow read: if hubMember();
      allow create: if hubMember() && hubItemOk(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
      allow update: if hubMember() && hubItemOk(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAdmin() || (hubMember() && resource.data.ownerUid == request.auth.uid);
    }

    // 参加の記録: 招待リンクの合言葉が正しいときだけ、自分の分を作れる
    match /sessions/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list, delete: if isAdmin();
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["staffId", "token", "createdAt"])
        && request.resource.data.staffId is string
        && request.resource.data.token is string
        && exists(/databases/$(database)/documents/staffTokens/$(request.resource.data.staffId))
        && get(/databases/$(database)/documents/staffTokens/$(request.resource.data.staffId)).data.token == request.resource.data.token;
    }
  }
}
